# Stage 2 reads backend/.env automatically; shell variables take precedence.
# Copy this template to backend/.env. Real credentials must stay out of Git.
STORAGE_BACKEND=json
DATA_DIR=data
STORAGE_FILE=var/demo-store.json
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Switch STORAGE_BACKEND to postgres after configuring your database.
# Copy the actual URI from your provider; URL-encode special password characters.
# DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@HOST:5432/postgres
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=10000

# Opt-in authentication proposal: review with Members 1/5 before enabling.
# Supabase mode requires PostgreSQL and migration 002 (migrate-auth command).
AUTH_MODE=demo
APP_ENV=development
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PROJECT_PUBLISHABLE_KEY
AUTH_TIMEOUT_SECONDS=5
# Proposed GET /account, GET /profile, GET /progress; enable after team review.
ENABLE_ACCOUNT_ROUTES=false
