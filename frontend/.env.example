# Copy to frontend/.env (never commit .env). Vite exposes only VITE_* variables.
# Base URL of Member 3's FastAPI backend. No trailing slash needed.
# If missing, Member 5's features default to http://127.0.0.1:8000.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Match backend AUTH_MODE. Demo mode is for fictional records only.
VITE_AUTH_MODE=demo
# Secure mode additionally requires backend ENABLE_ACCOUNT_ROUTES=true and migration 002.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PROJECT_PUBLISHABLE_KEY
